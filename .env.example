# NetBox Configuration
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=your-netbox-api-token-here

# LLM Backend Selection
# Choose backend: "ollama" or "llamacpp"
LLM_BACKEND=ollama

# Ollama Configuration (when LLM_BACKEND=ollama)
# Default below points at a cloud model (Ollama Cloud Pro subscription required —
# run `ollama signin` once, then the local daemon proxies :cloud models to ollama.com).
# For a fully local model swap OLLAMA_MODEL to e.g. qwen2.5:32b-instruct-q4_K_M.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-v4-pro:cloud
OLLAMA_TEMPERATURE=0.0

# Llama.cpp Configuration (when LLM_BACKEND=llamacpp — the fully-local path)
# Server is launched by scripts/serve_qwen4exp.sh (port 58123, ONE slot, -c 131072).
LLAMACPP_BASE_URL=http://localhost:58123/v1
LLAMACPP_MODEL=qwen3.8-flash-next-UD-Q4_K_XL
LLAMACPP_API_KEY=not-needed
# Context window declared to LangChain; KEEP IN STEP with -c in scripts/serve_qwen4exp.sh.
LLAMACPP_N_CTX=131072
# Output ceiling per model call (reasoning counts against it; see llamacpp_config.py).
LLAMACPP_MAX_TOKENS=8192
# Reasoning cap: low | medium | high | "" (send nothing). "low" prevents blank answers.
LLAMACPP_REASONING_EFFORT=low
# Blocking llm.invoke("test") at startup. The web server sets this to false in its own process.
LLAMACPP_VALIDATE_ON_INIT=true
# Streaming silence watchdog (seconds, 0 = off). langchain-openai's default of 120 kills a
# turn whenever a large tool result makes the next prefill exceed 120 s of silence.
LLAMACPP_STREAM_CHUNK_TIMEOUT_S=0
# GraphQL read tools on/off (A/B switch; default on).
ENABLE_GRAPHQL=1

# Web chat (python -m src.web; frontend at http://localhost:3010)
WEB_HOST=127.0.0.1
WEB_PORT=8010
WEB_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
WEB_MAX_QUEUE=4
WEB_TOOL_RESULT_PREVIEW_CHARS=2000
WEB_HEARTBEAT_S=15

# DeepAgents Configuration
DEEPAGENTS_LOG_LEVEL=INFO
DEEPAGENTS_USE_SKILLS=true
DEEPAGENTS_CACHE_ENABLED=true

# Development Settings
DEBUG=false
TEST_MODE=false
LOG_LEVEL=INFO

# MCP Server Configuration (optional)
MCP_SERVER_PATH=/home/ola/dev/rnd/mcp/testmcp/netbox-mcp-server

# NetBox GraphQL tool — read-only query-cost safety limits (optional; non-secret).
# The tool builds its endpoint ({NETBOX_URL}/graphql/) and auth from the config
# above; these only bound query cost. Defaults shown.
NETBOX_GQL_TIMEOUT=30
NETBOX_GQL_MAX_QUERY_CHARS=8000
NETBOX_GQL_MAX_RESPONSE_CHARS=200000
NETBOX_GQL_MAX_DEPTH=12

# LangSmith Tracing (optional, for debugging and observability)
# Get your API key from https://smith.langchain.com/
# LANGCHAIN_API_KEY=lsv2_pt_your_api_key_here
# LANGCHAIN_PROJECT=netbox-deepagents-ollama
# LANGCHAIN_TRACING_V2=true