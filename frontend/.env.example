# Frontend environment variables
# Copy to .env and adjust. Defaults match src/web/config.py (backend on 8010).

# WebSocket URL for the chat endpoint
NUXT_PUBLIC_WS_URL=ws://localhost:8010/ws/chat

# Backend REST base URL (/health, /status, /conversations/{id}/usage)
NUXT_PUBLIC_API_URL=http://localhost:8010

# Nuxt dev server port
PORT=3010
